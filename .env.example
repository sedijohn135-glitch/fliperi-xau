# ---------------------------------------------------------------------------
# REQUIRED — two variables, that is the whole setup
# ---------------------------------------------------------------------------
# The single Bearer token for https://mcp.ctrader.com/trading/mcp .
# It replaces the client id, client secret, refresh token, OAuth redirect URL
# and the mounted volume the Open API build needed. The account, the plant and
# the environment (demo/live) are all inside the token; the bot decodes and
# logs the environment on start-up.
CTRADER_MCP_TOKEN=replace-me-with-your-bearer-token
# Protects the panel. The panel can start a martingale, so it is never optional.
PANEL_PASSWORD=choose-a-strong-one

# paper = the engine runs and logs the orders it would send, nothing reaches
# the broker. Leave it here until you have watched a few cycles.
TRADING_MODE=paper

# ---------------------------------------------------------------------------
# INSTRUMENT
# ---------------------------------------------------------------------------
SYMBOL=XAUUSD
# A "pip" here is 0.01, not the 0.10 of FX convention: REVERSE_PIPS=30 means
# $0.30. Setting 0.10 would place every pending ten times too far away.
PIP_SIZE=0.01
POINT_SIZE=0.01
CONTRACT_SIZE=100
VOLUME_STEP=0.01
MIN_VOLUME=0.01

# ---------------------------------------------------------------------------
# THE CYCLE
# ---------------------------------------------------------------------------
START_LOTS=0.01
MULTIPLIER=2.0
REVERSE_PIPS=30
TRAIL_STEP_PIPS=5
STOP_PIPS=60
BASKET_TARGET_USD=5.0
FIRST_ENTRY=last_candle       # last_candle | buy | sell

# ---------------------------------------------------------------------------
# THE LIMITS — the only thing between this and an empty account
# ---------------------------------------------------------------------------
MAX_STEPS=6
MAX_TOTAL_LOTS=0.64
DAILY_LOSS_LIMIT_USD=100
MAX_SPREAD_PIPS=40

# ---------------------------------------------------------------------------
# NEWS BLACKOUT
# ---------------------------------------------------------------------------
NEWS_BLACKOUT=true
BLACKOUT_HOUR_UTC=12
BLACKOUT_MINUTE_UTC=30
BLACKOUT_DURATION_MIN=60

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AUTOSTART=false               # the engine never starts itself; true overrides
POLL_INTERVAL_SECONDS=2
LABEL=XAU_SAR_MG
LOG_LEVEL=INFO
